{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "securityProfile": {
      "enum": [
        "lab-sysadmin"
      ]
    },
    "image": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64}$"
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bgpAsn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "clusterId": {
          "type": "string",
          "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"
        },
        "ospfArea": {
          "type": "string",
          "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"
        }
      },
      "required": [
        "bgpAsn",
        "clusterId",
        "ospfArea"
      ]
    },
    "clients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z]([a-z0-9-]{0,18}[a-z0-9])?$"
          },
          "loopback": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/32$"
          }
        },
        "required": [
          "name",
          "loopback"
        ]
      }
    },
    "routers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z]([a-z0-9-]{0,18}[a-z0-9])?$"
          },
          "routerId": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"
          },
          "loopback": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/32$"
          },
          "nodeSelector": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kubernetes.io/hostname": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
              }
            },
            "required": [
              "kubernetes.io/hostname"
            ]
          },
          "vlanMaster": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,14}$"
          },
          "links": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "client": {
                  "type": "string",
                  "pattern": "^[a-z]([a-z0-9-]{0,18}[a-z0-9])?$"
                },
                "interface": {
                  "enum": [
                    "net1",
                    "net2",
                    "net3",
                    "net4"
                  ]
                },
                "vlanId": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4094
                },
                "localAddress": {
                  "type": "string",
                  "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/31$"
                },
                "remoteAddress": {
                  "type": "string",
                  "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"
                }
              },
              "required": [
                "client",
                "interface",
                "vlanId",
                "localAddress"
              ]
            }
          }
        },
        "required": [
          "name",
          "routerId",
          "loopback",
          "nodeSelector",
          "vlanMaster",
          "links"
        ]
      }
    },
    "topology": {
      "enum": [
        "four-client",
        "home-single-client"
      ]
    }
  },
  "required": [
    "securityProfile",
    "image",
    "cluster",
    "clients",
    "routers"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "topology"
        ],
        "properties": {
          "topology": {
            "const": "home-single-client"
          }
        }
      },
      "then": {
        "properties": {
          "clients": {
            "minItems": 1,
            "maxItems": 1
          },
          "routers": {
            "items": {
              "properties": {
                "links": {
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "properties": {
                      "interface": {
                        "const": "net1"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "clients": {
            "minItems": 4,
            "maxItems": 4
          },
          "routers": {
            "items": {
              "properties": {
                "links": {
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            }
          }
        }
      }
    }
  ]
}
